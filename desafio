<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Atividade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;800;900&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #F8F8F8;
    }
  </style>
</head>

<body class="p-6">
  <div class="max-w-4xl mx-auto">

    <!-- Situação 1 -->
    <div class="bg-white p-6 rounded-lg shadow-sm mb-8">

      <img src="/mnt/data/situacao1.jpeg"
           alt="Pessoa fotografando uma xícara de café com o celular"
           class="w-full rounded mb-4">

      <h2 class="text-xl font-bold mb-2" style="color: #6D64AE;">Situação 1</h2>
      <p class="text-gray-700 mb-4">
        Postar um “story” no Instagram mostrando uma xícara de café. O que essa ação pode significar?
      </p>

      <textarea id="resp1" class="w-full border rounded p-3 text-gray-700 bg-white mb-3" rows="4"
        placeholder="Escreva sua análise..."></textarea>

      <button onclick="enviar(1)" class="text-white px-6 py-2 rounded-md transition duration-300 font-semibold"
        style="background-color: #ff0040;"
        onmouseover="this.style.backgroundColor='#e00038'"
        onmouseout="this.style.backgroundColor='#ff0040'">
        Enviar resposta
      </button>

      <p id="feedback1" class="mt-3 font-semibold text-green-700"></p>
    </div>

    <!-- Situação 2 -->
    <div class="bg-white p-6 rounded-lg shadow-sm mb-8">

      <img src="/mnt/data/situaçao2.jpeg"
           alt="Pessoa segurando um celular com uma conversa de mensagens"
           class="w-full rounded mb-4">

      <h2 class="text-xl font-bold mb-2" style="color: #6D64AE;">Situação 2</h2>
      <p class="text-gray-700 mb-4">
        Usar o emoji 😂 em uma conversa de WhatsApp. O que essa ação pode significar?
      </p>

      <textarea id="resp2" class="w-full border rounded p-3 text-gray-700 bg-white mb-3" rows="4"
        placeholder="Escreva sua análise..."></textarea>

      <button onclick="enviar(2)" class="text-white px-6 py-2 rounded-md transition duration-300 font-semibold"
        style="background-color: #ff0040;"
        onmouseover="this.style.backgroundColor='#e00038'"
        onmouseout="this.style.backgroundColor='#ff0040'">
        Enviar resposta
      </button>

      <p id="feedback2" class="mt-3 font-semibold text-green-700"></p>
    </div>

  </div>

  <script>
    function enviar(num) {
      const textarea = document.getElementById("resp" + num);
      const feedback = document.getElementById("feedback" + num);

      if (textarea.value.trim() === "") {
        feedback.textContent = "Por favor, escreva sua resposta antes de enviar.";
        feedback.classList.remove("text-green-700");
        feedback.classList.add("text-red-600");
        return;
      }

      feedback.textContent = "Resposta enviada com sucesso!";
      feedback.classList.remove("text-red-600");
      feedback.classList.add("text-green-700");
      textarea.disabled = true;
    }
  </script>
</body>
</html>
